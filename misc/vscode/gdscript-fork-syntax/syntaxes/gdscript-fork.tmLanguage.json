{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "GDScript fork syntax",
	"scopeName": "source.gdscript.fork",
	"injectionSelector": "L:source.gdscript -comment -string",
	"patterns": [
		{
			"include": "#generic_function"
		},
		{
			"include": "#generic_class"
		},
		{
			"include": "#struct_declaration"
		},
		{
			"include": "#uses_statement"
		},
		{
			"include": "#struct_keyword"
		},
		{
			"include": "#arrow_parameter"
		},
		{
			"include": "#arrow"
		},
		{
			"include": "#null_operators"
		},
		{
			"include": "#nullable_type"
		}
	],
	"repository": {
		"generic_function": {
			"comment": "`func first[T](...)`. The bundled grammar wants `(` right after the name, so it gives up here.",
			"begin": "\\b(func)\\s+([A-Za-z_]\\w*)\\s*(\\[)",
			"beginCaptures": {
				"1": {
					"name": "keyword.language.gdscript storage.type.function.gdscript"
				},
				"2": {
					"name": "entity.name.function.gdscript"
				},
				"3": {
					"name": "punctuation.definition.typeparameters.begin.gdscript"
				}
			},
			"end": "(\\])|$",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.typeparameters.end.gdscript"
				}
			},
			"patterns": [
				{
					"include": "#type_parameter"
				}
			]
		},
		"generic_class": {
			"comment": "`class Pool[T]:`. Same story: the bundled grammar wants `:` right after the name.",
			"begin": "\\b(class)\\s+([A-Za-z_]\\w*)\\s*(\\[)",
			"beginCaptures": {
				"1": {
					"name": "keyword.language.gdscript"
				},
				"2": {
					"name": "entity.name.type.class.gdscript"
				},
				"3": {
					"name": "punctuation.definition.typeparameters.begin.gdscript"
				}
			},
			"end": "(\\])|$",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.typeparameters.end.gdscript"
				}
			},
			"patterns": [
				{
					"include": "#type_parameter"
				}
			]
		},
		"type_parameter": {
			"patterns": [
				{
					"match": ",",
					"name": "punctuation.separator.typeparameters.gdscript"
				},
				{
					"match": ":",
					"name": "punctuation.separator.type.gdscript"
				},
				{
					"match": "\\b[A-Za-z_]\\w*\\b",
					"name": "entity.name.type.gdscript"
				}
			],
			"comment": "A type parameter and, after `:`, its bound. Both are type names."
		},
		"struct_declaration": {
			"match": "^\\s*(struct)\\s+([A-Za-z_]\\w*)",
			"captures": {
				"1": {
					"name": "keyword.language.gdscript storage.type.struct.gdscript"
				},
				"2": {
					"name": "entity.name.type.struct.gdscript"
				}
			}
		},
		"uses_statement": {
			"comment": "`uses Damageable, Named`. Guarded so a variable called `uses` is left alone.",
			"match": "^\\s*(uses)\\s+(?=[A-Za-z_])",
			"captures": {
				"1": {
					"name": "keyword.language.gdscript"
				}
			}
		},
		"struct_keyword": {
			"match": "\\b(struct)\\b",
			"name": "keyword.language.gdscript"
		},
		"arrow_parameter": {
			"comment": "`item => ...`. This has to start at the parameter, not at the arrow: inside a call the bundled grammar reads `item =` as a named argument and gets there first.",
			"match": "\\b([A-Za-z_]\\w*)\\s*(=>)",
			"captures": {
				"1": {
					"name": "variable.parameter.gdscript"
				},
				"2": {
					"name": "keyword.operator.arrow.gdscript"
				}
			}
		},
		"nullable_type": {
			"comment": "The `?` of `Node?`. Anything left once the operators above have had their turn: GDScript has no ternary, so a bare `?` is always a nullable type.",
			"match": "\\?",
			"name": "keyword.operator.nullable.gdscript"
		},
		"null_operators": {
			"comment": "`??`, and the `?` of `?.` and `?[`. Without this they read as assignment, comparison or a stray question mark.",
			"match": "\\?\\?|\\?(?=[.\\[])",
			"name": "keyword.operator.null.gdscript"
		},
		"arrow": {
			"comment": "Short lambdas. Without this, `=>` reads as assignment followed by greater-than.",
			"match": "=>",
			"name": "keyword.operator.arrow.gdscript"
		}
	}
}
